<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="warehouse_rover_visual_link">
    <visual name="warehouse_rover_glb">
      <origin xyz="0 0 0.05" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://warehouse_description/models/warehouse_rover/meshes/WAREhouse_rover.glb"
              scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <!-- Original physical base_link is wheel-radius height above ground_contact. -->
  <joint name="warehouse_rover_visual_joint" type="fixed">
    <parent link="base_link"/>
    <child link="warehouse_rover_visual_link"/>
    <origin xyz="0 0 -${wheel_radius}" rpy="0 0 0"/>
  </joint>
</robot>
